  "nodes": [
    {
      "id": 0,
      "speaker": "리리스",
      "text": "음악실 도착. 음... 열화상 카메라에는 아무것도 안 잡히는데?",
      "characterSprite": "Characters/리리스/기본",
      "backgroundSprite": "Images/lobby_bg",
      "nextNodeId": 1
    },
    {
      "id": 1,
      "speaker": "리나",
      "text": "에이, 재미없게. 확 문 열어버린다?",
      "characterSprite": "Characters/리나/기본",
      "nextNodeId": 2
    },
    {
      "id": 2,
      "speaker": "미나",
      "text": "(통신기) 크큭... 함부로 열지 마라. 그 안에는 강대한 원념이 도사리고 있으니...",
      "characterSprite": "Characters/미나/기본",
      "nextNodeId": 3
    },
    {
      "id": 3,
      "speaker": "카스미",
      "text": "미나, 쓸데없는 소리 말고 해킹한 CCTV 자료나 넘겨.",
      "characterSprite": "Characters/카스미/기본",
      "nextNodeId": 4
    },
    {
      "id": 4,
      "speaker": "미나",
      "text": "...쳇. 전송 완료.",
      "characterSprite": "Characters/미나/기본",
      "nextNodeId": 5
    },
    {
      "id": 5,
      "speaker": "리리스",
      "text": "자료 들어왔어. 앗, 잠깐만... 이 흔적들은 뭐야?",
      "characterSprite": "Characters/리리스/기본",
      "nextNodeId": 6
    },
    {
      "id": 6,
      "speaker": "카스미",
      "text": "단서가 꽤 있군요. 본격적으로 현장을 조사해 봅시다.",
      "characterSprite": "Characters/카스미/기본",
      "nextNodeId": -1,
      "command": "CHANGE_PHASE:Investigation"
    }
  ]
}
